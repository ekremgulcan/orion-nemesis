<?page title="Orion"?>
<!--
  groupbox-polish.css uygulama capinda paylasilan bir stil dosyasidir.
  <?link?> sayfa-seviyesinde bir direktif oldugu ve alt ekranlarin
  <include src="..."/> ile yuklenen icerigine YAYILMADIGI icin (dogrulandi:
  bir alt .zul dosyasinin kendi basina <?link?> tanimlamasi index.zul'un
  tabbox'u icinde HICBIR ETKI etmiyor), bu dosya sadece burada, gercek
  ust-seviye sayfada tanimlanir - boylece tum ekranlarda (hangi tab'da
  acilirsa acilsin) tek seferde devreye girer.
-->
<?link rel="stylesheet" type="text/css" href="/common/groupbox-polish.css"?>
<zk xmlns:n="native">
    <borderlayout apply="org.zkoss.bind.BindComposer"
                  viewModel="@id('vm') @init('com.orion.nav.IndexViewModel')"
                  height="100%" width="100%">

        <north height="60px" style="background-color:#4a86a8">
            <hbox align="center" pack="justify" hflex="1" style="height:100%;padding:0 16px;box-sizing:border-box">
                <label value="Orion" style="color:white;font-size:22px;font-weight:bold"/>
                <hbox align="center" spacing="8px">
                    <label value="Aktif Kullanici:" style="color:white"/>
                    <listbox mold="select" rows="1" width="180px"
                             model="@load(vm.kullaniciSecenekleri)"
                             onSelect="@command('kullaniciDegistir', kullaniciAdi=self.selectedItem.value.kullaniciAdi)">
                        <template name="model">
                            <listitem value="@load(each)" label="@load(each.adSoyad)"
                                      selected="@load(each.kullaniciAdi eq vm.aktifKullaniciAdi)"/>
                        </template>
                    </listbox>
                </hbox>
            </hbox>
        </north>

        <west size="260px" splittable="true" collapsible="true">
            <vlayout vflex="1" hflex="1" style="height:100%">
                <toolbarbutton label="Ana Sayfa" iconSclass="z-icon-home"
                                onClick="@command('goHome')"
                                style="width:100%;text-align:left;padding:8px"/>
                <listbox model="@load(vm.menuRows)" vflex="1" hflex="1" style="border:none">
                    <listhead visible="false">
                        <listheader hflex="1"/>
                    </listhead>
                    <template name="model">
                    <!--
                        Tek tiklama hedefi: satirin tamami (listitem) hem
                        navigasyonu hem (varsa) alt menu genislet/daralt
                        toggle'ini birlikte yapar (selectMenu). Ok isareti
                        sadece GORSEL bir gostergedir, ayri bir onClick'i
                        YOK - ZK'nin @command binding'i gercek DOM
                        stopPropagation'i desteklemedigi icin, ok'a ayri
                        bir tiklama davranisi eklemek (listitem'in kendi
                        onClick'i ile birlikte) cift-tetiklenmeye (toggle'in
                        iki kez calisip birbirini iptal etmesine) yol acardi.
                    -->
                        <listitem style="@load(each.child ? 'padding-left:32px' : '')"
                                  onClick="@command('selectMenu', item=each.item)">
                            <listcell>
                                <n:div style="display:flex;justify-content:space-between;align-items:center;width:100%;padding:6px 4px;box-sizing:border-box">
                                    <hbox spacing="5px" align="center">
                                        <label value="@load(each.child ? '&#8250;' : '')"
                                               style="color:#8a97a3;font-size:0.85em"/>
                                        <label value="@load(each.item.baslik)"
                                               style="@load(each.child ? 'color:#7a8a99;font-size:0.93em' : '')"/>
                                    </hbox>
                                    <label value="@load(each.item.hasChildren and not each.child ? (each.expanded ? '&#9662;' : '&#9656;') : '')"
                                           width="20px"
                                           style="text-align:center;font-size:1.35em"/>
                                </n:div>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </vlayout>
        </west>

        <center>
            <tabbox vflex="1" hflex="1">
                <tabs children="@load(vm.openTabs)">
                    <template name="children">
                        <tab label="@load(each.baslik)" closable="@load(each.closable)"
                             selected="@load(each eq vm.selectedTab)"
                             onClose="@command('closeTab', tab=each)"
                             onSelect="@command('selectTab', tab=each)"/>
                    </template>
                </tabs>
                <tabpanels vflex="1" children="@load(vm.openTabs)">
                    <template name="children">
                        <tabpanel style="overflow:auto;height:100%">
                            <include src="@load(each.fullZulPath)"/>
                        </tabpanel>
                    </template>
                </tabpanels>
            </tabbox>
        </center>
    </borderlayout>
</zk>
