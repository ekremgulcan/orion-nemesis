<?page title="Musteri Bildirim Tercihleri"?>
<?component name="musteriSorgulamaKutusu" macroURI="/common/musteri-sorgulama-kutusu.zul" inline="true"?>
<?component name="musteriBilgiPaneli" macroURI="/common/musteri-bilgi-paneli.zul" inline="true"?>
<zk xmlns:n="native">
    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.orion.notification.vm.MusteriBildirimTercihleriViewModel')"
            style="padding:16px">

        <style>
            /* Checkbox'lari iOS tarzi acik/kapali toggle gibi gostermek icin -
               ZK7'de native bir Switch bileseni yok, mevcut checkbox input'u
               CSS ile yeniden skin'lenir; @bind(checked) davranisi degismez. */
            .toggle-switch input[type="checkbox"] {
                -webkit-appearance: none;
                appearance: none;
                width: 34px;
                height: 18px;
                background: #c6ccd4;
                border-radius: 9px;
                position: relative;
                cursor: pointer;
                outline: none;
                vertical-align: middle;
                transition: background 0.15s;
            }
            .toggle-switch input[type="checkbox"]:checked {
                background: #2f6fad;
            }
            .toggle-switch input[type="checkbox"]::before {
                content: "";
                position: absolute;
                top: 2px;
                left: 2px;
                width: 14px;
                height: 14px;
                border-radius: 50%;
                background: #fff;
                transition: left 0.15s;
            }
            .toggle-switch input[type="checkbox"]:checked::before {
                left: 18px;
            }
            .toggle-switch input[type="checkbox"]:disabled {
                opacity: 0.55;
                cursor: not-allowed;
            }
        </style>

        <label value="Musteri Bildirim Tercihleri Ekrani"
               style="color:#2f6fad;font-size:20px;font-weight:bold"/>
        <separator/>

        <musteriSorgulamaKutusu/>

        <div visible="@load(vm.musteriBulunduMu)">
            <musteriBilgiPaneli/>

            <n:div style="border:1px solid #d7dde3;border-radius:6px;margin-top:16px;overflow:hidden">
                <n:div style="background:#2f6fad;color:white;padding:10px 16px;font-weight:bold;display:flex;justify-content:space-between;align-items:center">
                    <n:span>Bildirim Tercihleri (Bildirim Tipi Bazinda)</n:span>
                    <n:span>&#9650;</n:span>
                </n:div>
                <n:div style="padding:16px">
                    <n:div style="display:flex;justify-content:flex-end;gap:20px;margin-bottom:10px;font-size:0.85em;color:#8a97a3">
                        <n:span style="display:flex;align-items:center;gap:4px">
                            <n:span>&#128274;</n:span>Zorunlu (Duzenlenemez)
                        </n:span>
                        <n:span style="display:flex;align-items:center;gap:4px">
                            <n:span>&#9999;</n:span>Duzenlenebilir
                        </n:span>
                    </n:div>

                    <listbox model="@load(vm.tercihler)" emptyMessage="Kayit yok">
                        <listhead>
                            <listheader label="Bildirim Tipi" width="300px"/>
                            <listheader label="Push Bildirim" style="text-align:center"/>
                            <listheader label="SMS" style="text-align:center"/>
                            <listheader label="E-Posta" style="text-align:center"/>
                        </listhead>
                        <template name="model">
                            <listitem>
                                <listcell>
                                    <n:div style="display:flex;align-items:center;gap:6px">
                                        <label value="@load(each.notificationType.ad)" style="font-weight:500"/>
                                        <label value="&#8505;" style="color:#8a97a3;cursor:help"
                                               tooltiptext="@load(each.notificationType.aciklama)"/>
                                    </n:div>
                                </listcell>
                                <listcell style="text-align:center">
                                    <n:div style="display:flex;align-items:center;justify-content:center;gap:6px">
                                        <label value="&#128274;" visible="@load(each.notificationType.zorunlu)"/>
                                        <checkbox sclass="toggle-switch" checked="@bind(each.pushAcik)"
                                                  disabled="@load(each.notificationType.zorunlu)"/>
                                        <label value="@load(each.pushAcik ? 'Acik' : 'Kapali')"/>
                                    </n:div>
                                </listcell>
                                <listcell style="text-align:center">
                                    <n:div style="display:flex;align-items:center;justify-content:center;gap:6px">
                                        <label value="&#128274;" visible="@load(each.notificationType.zorunlu)"/>
                                        <checkbox sclass="toggle-switch" checked="@bind(each.smsAcik)"
                                                  disabled="@load(each.notificationType.zorunlu)"/>
                                        <label value="@load(each.smsAcik ? 'Acik' : 'Kapali')"/>
                                    </n:div>
                                </listcell>
                                <listcell style="text-align:center">
                                    <n:div style="display:flex;align-items:center;justify-content:center;gap:6px">
                                        <label value="&#128274;" visible="@load(each.notificationType.zorunlu)"/>
                                        <checkbox sclass="toggle-switch" checked="@bind(each.epostaAcik)"
                                                  disabled="@load(each.notificationType.zorunlu)"/>
                                        <label value="@load(each.epostaAcik ? 'Acik' : 'Kapali')"/>
                                    </n:div>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>

                    <n:div style="display:flex;justify-content:flex-end;margin-top:16px">
                        <button label="Onaya Gonder" iconSclass="z-icon-envelope-o"
                                style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                                onClick="@command('onayaGonder')"/>
                    </n:div>
                </n:div>
            </n:div>
        </div>
    </window>
</zk>
