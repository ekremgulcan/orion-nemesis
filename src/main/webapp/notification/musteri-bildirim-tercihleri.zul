<?page title="Musteri Bildirim Tercihleri"?>
<?component name="musteriSorgulamaKutusu" macroURI="/common/musteri-sorgulama-kutusu.zul" inline="true"?>
<?component name="musteriBilgiPaneli" macroURI="/common/musteri-bilgi-paneli.zul" inline="true"?>
<zk xmlns:n="native">
    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.orion.notification.vm.MusteriBildirimTercihleriViewModel')"
            style="padding:16px">

        <style>
            /* Checkbox'lari iOS tarzi acik/kapali toggle gibi gostermek icin -
               ZK7'de native bir Switch bileseni yok, mevcut checkbox input'u
               CSS ile yeniden skin'lenir; @bind(checked) davranisi degismez. */
            .toggle-switch input[type="checkbox"] {
                -webkit-appearance: none;
                appearance: none;
                width: 34px;
                height: 18px;
                background: #c6ccd4;
                border-radius: 9px;
                position: relative;
                cursor: pointer;
                outline: none;
                vertical-align: middle;
                transition: background 0.15s;
            }
            .toggle-switch input[type="checkbox"]:checked {
                background: #2f6fad;
            }
            .toggle-switch input[type="checkbox"]::before {
                content: "";
                position: absolute;
                top: 2px;
                left: 2px;
                width: 14px;
                height: 14px;
                border-radius: 50%;
                background: #fff;
                transition: left 0.15s;
            }
            .toggle-switch input[type="checkbox"]:checked::before {
                left: 18px;
            }
            .toggle-switch input[type="checkbox"]:disabled {
                opacity: 0.55;
                cursor: not-allowed;
            }
            .kategori-genislet-oku {
                cursor: pointer;
                color: #8a97a3;
                display: inline-block;
                margin-top: 2px;
                font-size: 0.75em;
                user-select: none;
            }
        </style>

        <label value="Musteri Bildirim Tercihleri Ekrani"
               style="color:#2f6fad;font-size:20px;font-weight:bold"/>

        <!-- Inceleme modunda musteri sorgulama gizlenir (musteri otomatik yuklenir) -->
        <div visible="@load(not vm.incelemeModu)">
            <musteriSorgulamaKutusu/>
        </div>

        <div visible="@load(vm.musteriBulunduMu)">
            <musteriBilgiPaneli/>

            <groupbox closable="false" style="margin-top:10px">
                <caption label="Bildirim Tercihleri (Kategori Bazinda)"/>
                <n:div style="padding:0 16px;display:flex;justify-content:flex-end;gap:20px;margin-bottom:4px;font-size:0.85em;color:#8a97a3">
                    <n:span style="display:flex;align-items:center;gap:4px">
                        <n:span>&#128274;</n:span>Zorunlu (Duzenlenemez)
                    </n:span>
                    <n:span style="display:flex;align-items:center;gap:4px">
                        <n:span>&#9999;</n:span>Duzenlenebilir
                    </n:span>
                </n:div>

                <listbox model="@load(vm.tercihler)" emptyMessage="Kayit yok">
                    <listhead>
                        <listheader label="Kategori Adi" width="220px"/>
                        <listheader label="Kategori Icerigi"/>
                        <listheader label="Push Bildirim" width="150px" style="text-align:center"/>
                        <listheader label="SMS" width="120px" style="text-align:center"/>
                        <listheader label="E-Posta" width="120px" style="text-align:center"/>
                    </listhead>
                    <template name="model">
                        <listitem>
                            <listcell style="padding:8px 10px;vertical-align:top">
                                <n:div style="display:flex;align-items:flex-start;gap:6px">
                                    <a onClick="@command('kategoriGenisletDaralt', kategori=each)">
                                        <label value="@load(each.expanded ? '&#9660;' : '&#9654;')" sclass="kategori-genislet-oku"/>
                                    </a>
                                    <label value="@load(each.categoryName)" style="font-weight:500"/>
                                </n:div>
                            </listcell>
                            <listcell style="padding:8px 10px;vertical-align:top">
                                <n:div style="display:flex;flex-wrap:wrap;align-items:center">
                                    <html content="@load(each.countBadgeHtml)"/>
                                    <span visible="@load(each.expanded)"><html content="@load(each.detailBadgeHtml)"/></span>
                                </n:div>
                            </listcell>
                            <listcell style="text-align:center;padding:8px 10px;vertical-align:top">
                                <n:div style="display:flex;align-items:center;justify-content:center;gap:6px">
                                    <label value="&#128274;" visible="@load(not each.pushEditable)"/>
                                    <checkbox sclass="toggle-switch" checked="@bind(each.pushAcik)"
                                              disabled="@load(not each.pushEditable or vm.incelemeModu)"/>
                                    <label value="@load(each.pushAcik ? 'Acik' : 'Kapali')"/>
                                </n:div>
                            </listcell>
                            <listcell style="text-align:center;padding:8px 10px;vertical-align:top">
                                <n:div style="display:flex;align-items:center;justify-content:center;gap:6px">
                                    <label value="&#128274;" visible="@load(not each.smsEditable)"/>
                                    <checkbox sclass="toggle-switch" checked="@bind(each.smsAcik)"
                                              disabled="@load(not each.smsEditable or vm.incelemeModu)"/>
                                    <label value="@load(each.smsAcik ? 'Acik' : 'Kapali')"/>
                                </n:div>
                            </listcell>
                            <listcell style="text-align:center;padding:8px 10px;vertical-align:top">
                                <n:div style="display:flex;align-items:center;justify-content:center;gap:6px">
                                    <label value="&#128274;" visible="@load(not each.epostaEditable)"/>
                                    <checkbox sclass="toggle-switch" checked="@bind(each.epostaAcik)"
                                              disabled="@load(not each.epostaEditable or vm.incelemeModu)"/>
                                    <label value="@load(each.epostaAcik ? 'Acik' : 'Kapali')"/>
                                </n:div>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>

                <n:div style="padding:0 16px 12px;display:flex;justify-content:flex-end;margin-top:8px;gap:8px">
                    <!-- Normal mod: Onaya Gonder butonu -->
                    <button label="Onaya Gonder" iconSclass="z-icon-envelope-o"
                            style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                            onClick="@command('onayaGonder')"
                            visible="@load(not vm.incelemeModu)"/>

                    <!-- Inceleme modu: Onayla / Reddet butonlari -->
                    <button label="Onayla" iconSclass="z-icon-check"
                            style="background:#2f9e44 !important;color:white !important;text-shadow:none !important"
                            onClick="@command('onaylaCommand')"
                            visible="@load(vm.onayBekliyor)"/>
                    <button label="Reddet" iconSclass="z-icon-times"
                            style="background:#c85c5c !important;color:white !important;text-shadow:none !important"
                            onClick="@command('reddetCommand')"
                            visible="@load(vm.onayBekliyor)"/>
                </n:div>
            </groupbox>
        </div>

        <!-- Degisiklik Onizleme Popup (Diff) -->
        <window title="Degisiklik Onizleme" mode="modal" border="normal"
                width="650px" closable="true"
                visible="@load(vm.diffPopupAcik)"
                onClose="@command('closeDiffPopup')"
                style="padding:16px">
            <label value="Asagidaki tercih degisiklikleri onay beklemektedir:"
                   style="color:#2f6fad;font-weight:bold;font-size:14px;display:block;margin-bottom:10px"/>
            <listbox model="@load(vm.degisiklikListesi)" emptyMessage="Degisiklik bulunamadi">
                <listhead>
                    <listheader label="Kategori" width="200px"/>
                    <listheader label="Kanal" width="130px"/>
                    <listheader label="Eski Deger" width="110px"/>
                    <listheader label="Yeni Deger" width="110px"/>
                </listhead>
                <template name="model">
                    <listitem>
                        <listcell label="@load(each.kategori)"/>
                        <listcell label="@load(each.alan)"/>
                        <listcell label="@load(each.eskiDeger)"
                                  style="color:#c85c5c;font-weight:bold"/>
                        <listcell label="@load(each.yeniDeger)"
                                  style="color:#2f9e44;font-weight:bold"/>
                    </listitem>
                </template>
            </listbox>
            <n:div style="text-align:right;margin-top:12px">
                <button label="Kapat" onClick="@command('closeDiffPopup')"/>
            </n:div>
        </window>
    </window>
</zk>
