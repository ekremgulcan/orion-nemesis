<!--
  Yeniden kullanilabilir "Musteri Bilgileri" ozet paneli (macro component,
  inline="true"). musteri-sorgulama-kutusu.zul ile birlikte kullanilir:
  musteri bulundugunda musteri kimlik bilgilerini gosterir.

  Kullanan sayfanin ViewModel'i ('vm') su getter'lari sunmalidir (hepsi
  String, sonGuncelleme zaten formatlanmis olmali):
    getMusteriAdi(), getMusteriTcknVkn(), getMusteriDurum(), getMusteriSonGuncelleme()

  Diger ekranlardaki standart bolum cercevesiyle tutarli olmasi icin
  native bordered/banner div yerine gercek <groupbox>/<caption> kullanilir;
  ic alanlardaki flex satir duzeni statik (binding olmayan) bir stil
  oldugu icin native <n:div> ile kaliyor.
-->
<zk xmlns:n="native">
    <groupbox closable="false" style="margin-top:10px">
        <caption label="Musteri Bilgileri"/>
        <n:div style="padding:8px 16px 12px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:24px">
            <n:div>
                <label value="Musteri Adi" style="color:#8a97a3;font-size:0.85em;display:block"/>
                <label value="@load(vm.musteriAdi)" style="font-size:1.05em;font-weight:bold"/>
            </n:div>
            <n:div>
                <label value="TCKN / VKN" style="color:#8a97a3;font-size:0.85em;display:block"/>
                <label value="@load(vm.musteriTcknVkn)" style="font-size:1.05em;font-weight:bold"/>
            </n:div>
            <n:div>
                <label value="Durum" style="color:#8a97a3;font-size:0.85em;display:block"/>
                <label value="@load(vm.musteriDurum)" style="font-size:1.05em;font-weight:bold"/>
            </n:div>
            <n:div>
                <label value="Son Guncelleme" style="color:#8a97a3;font-size:0.85em;display:block"/>
                <label value="@load(vm.musteriSonGuncelleme)" style="font-size:1.05em;font-weight:bold"/>
            </n:div>
        </n:div>
    </groupbox>
</zk>
