<?page title="Teminat Transfer"?>
<zk>
    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.orion.collateral.vm.TeminatTransferViewModel')"
            style="padding:16px">

        <label value="Teminat Transfer"
               style="color:#2f6fad;font-size:20px;font-weight:bold"/>
        <separator/>

        <groupbox closable="false" style="margin-top:10px">
            <caption label="Yeni Transfer Talebi"/>
            <grid>
                <columns>
                    <column width="140px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <label value="Hesap No:"/>
                        <textbox value="@bind(vm.hesapNo)" width="200px"/>
                    </row>
                    <row>
                        <label value="Piyasa:"/>
                        <textbox value="@bind(vm.piyasa)" width="150px"/>
                    </row>
                    <row>
                        <label value="Saklamaci:"/>
                        <textbox value="@bind(vm.saklamaci)" width="150px"/>
                    </row>
                    <row>
                        <label value="Teminat Tipi:"/>
                        <combobox value="@bind(vm.teminatTipi)" width="220px">
                            <comboitem label="NAKIT_DOVIZ"/>
                            <comboitem label="PAY_SENEDI"/>
                            <comboitem label="BORCLANMA_ARACI"/>
                            <comboitem label="FON"/>
                        </combobox>
                    </row>
                    <row>
                        <label value="Kaynak Depo:"/>
                        <combobox value="@bind(vm.kaynakDepo)" width="180px">
                            <comboitem label="SERBEST"/>
                            <comboitem label="TEMINAT"/>
                        </combobox>
                    </row>
                    <row>
                        <label value="Hedef Depo:"/>
                        <combobox value="@bind(vm.hedefDepo)" width="180px">
                            <comboitem label="TEMINAT"/>
                            <comboitem label="SERBEST"/>
                        </combobox>
                    </row>
                    <row>
                        <label value="Para Birimi:"/>
                        <combobox value="@bind(vm.paraBirimi)" width="120px">
                            <comboitem label="TRY"/>
                            <comboitem label="USD"/>
                            <comboitem label="EUR"/>
                        </combobox>
                    </row>
                    <row>
                        <label value="Miktar:"/>
                        <decimalbox value="@bind(vm.miktar)" cols="15"/>
                    </row>
                    <row>
                        <label value="Aciklama:"/>
                        <textbox value="@bind(vm.aciklama)" width="320px"/>
                    </row>
                </rows>
            </grid>
            <hbox spacing="10px" style="margin-top:10px">
                <button label="Transfer Talebi Olustur"
                        style="background:#c85c5c !important;color:white !important;text-shadow:none !important"
                        onClick="@command('talepOlustur')"/>
                <label value="@load(vm.mesaj)" style="color:#2f6fad;font-weight:bold"/>
            </hbox>
        </groupbox>

        <separator style="margin-top:14px"/>
        <label value="Serbest Depo / Teminat Deposu Kalemleri" style="font-weight:bold;margin-top:6px"/>
        <hbox spacing="8px" align="center" style="margin-top:6px">
            <label value="Ara:"/>
            <textbox value="@bind(vm.depoAramaMetni)" width="260px"
                     placeholder="Hesap No / Musteri / Enstruman"/>
            <button label="Ara" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                    onClick="@command('depoAra')"/>
        </hbox>
        <listbox model="@load(vm.depoKalemleri)" mold="paging" pageSize="15"
                 emptyMessage="No Rows To Show" style="margin-top:6px">
            <listhead>
                <listheader label="Hesap No" width="100px"/>
                <listheader label="Musteri"/>
                <listheader label="Depo Tipi" width="100px"/>
                <listheader label="Varlik Tipi" width="140px"/>
                <listheader label="Enstruman" width="100px"/>
                <listheader label="Para Birimi" width="100px"/>
                <listheader label="Miktar" width="120px"/>
            </listhead>
            <template name="model">
                <listitem>
                    <listcell label="@load(each.account.hesapNo)"/>
                    <listcell label="@load(each.account.customer.adSoyadUnvan)"/>
                    <listcell label="@load(each.depoTipi)"/>
                    <listcell label="@load(each.varlikTipi)"/>
                    <listcell label="@load(each.instrument.sembol)"/>
                    <listcell label="@load(each.paraBirimi)"/>
                    <listcell label="@load(each.miktar)"/>
                </listitem>
            </template>
        </listbox>
    </window>
</zk>
