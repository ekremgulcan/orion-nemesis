<?page title="Yonetim Paneli"?>
<zk>
    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.orion.core.vm.KullaniciListesiViewModel')"
            style="padding:16px">

        <label value="Yonetim Paneli - Kullanici / Rol Listesi"
               style="color:#2f6fad;font-size:20px;font-weight:bold"/>
        <separator/>

        <groupbox closable="false" style="margin-top:10px">
            <caption label="Kullanici Ekle / Duzenle"/>
            <hbox spacing="20px">
                <grid width="420px">
                    <columns>
                        <column width="140px"/>
                        <column/>
                    </columns>
                    <rows>
                        <row>
                            <label value="Kullanici Adi:"/>
                            <textbox value="@bind(vm.kullaniciAdi)" width="220px"/>
                        </row>
                        <row>
                            <label value="Ad Soyad:"/>
                            <textbox value="@bind(vm.adSoyad)" width="220px"/>
                        </row>
                        <row>
                            <label value="E-Posta:"/>
                            <textbox value="@bind(vm.email)" width="220px"/>
                        </row>
                        <row>
                            <label value="Aktif:"/>
                            <checkbox checked="@bind(vm.aktif)"/>
                        </row>
                    </rows>
                </grid>
                <vbox>
                    <label value="Roller:" style="font-weight:bold"/>
                    <listbox model="@load(vm.tumRoller)" checkmark="true" multiple="true"
                             selectedItems="@bind(vm.secilenRoller)"
                             height="120px" width="220px">
                        <template name="model">
                            <listitem label="@load(each.rolAdi)"/>
                        </template>
                    </listbox>
                </vbox>
            </hbox>
            <hbox spacing="10px" style="margin-top:10px">
                <button label="Kaydet" style="background:#4caf50 !important;color:white !important;text-shadow:none !important"
                        onClick="@command('kaydet')"/>
                <button label="Yeni Kullanici" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                        onClick="@command('yeniKullanici')"/>
            </hbox>
        </groupbox>

        <separator style="margin-top:14px"/>
        <hbox spacing="8px" align="center" style="margin-top:6px">
            <label value="Ara:"/>
            <textbox value="@bind(vm.aramaMetni)" width="260px"
                     placeholder="Kullanici Adi / Ad Soyad / E-Posta"/>
            <button label="Ara" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                    onClick="@command('ara')"/>
        </hbox>

        <listbox model="@load(vm.kullanicilar)" mold="paging" pageSize="20"
                 emptyMessage="No Rows To Show" style="margin-top:10px">
            <listhead>
                <listheader label="Kullanici Adi" width="140px"/>
                <listheader label="Ad Soyad" width="180px"/>
                <listheader label="E-Posta" width="200px"/>
                <listheader label="Roller"/>
                <listheader label="Aktif" width="70px"/>
                <listheader label="Aksiyon" width="140px"/>
            </listhead>
            <template name="model">
                <listitem>
                    <listcell label="@load(each.kullaniciAdi)"/>
                    <listcell label="@load(each.adSoyad)"/>
                    <listcell label="@load(each.email)"/>
                    <listcell label="@load(vm.rolleriGetir(each))"/>
                    <listcell label="@load(each.aktif ? 'Evet' : 'Hayir')"/>
                    <listcell>
                        <hbox spacing="6px">
                            <button label="Duzenle" style="background:#e08020 !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('duzenle', item=each)"/>
                            <button label="Sil" style="background:#c85c5c !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('sil', item=each)"/>
                        </hbox>
                    </listcell>
                </listitem>
            </template>
        </listbox>
    </window>
</zk>
