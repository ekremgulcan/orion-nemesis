<?page title="Piyasa Veri Yonetimi"?>
<zk>
    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.orion.core.vm.PiyasaVeriYonetimiViewModel')"
            style="padding:16px">

        <label value="Piyasa Veri Yonetimi"
               style="color:#2f6fad;font-size:20px;font-weight:bold"/>
        <label value="Fiyat besleme/entegrasyon yonetimi Faz 4+ kapsaminda eklenecektir. Asagida referans enstruman verisi (master data) yonetilmektedir."
               style="color:#888;font-size:12px;margin-top:4px"/>
        <separator/>

        <groupbox closable="false" style="margin-top:10px">
            <caption label="Enstruman Ekle / Duzenle"/>
            <grid>
                <columns>
                    <column width="140px"/>
                    <column/>
                    <column width="140px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <label value="Sembol:"/>
                        <textbox value="@bind(vm.sembol)" width="150px"/>
                        <label value="ISIN:"/>
                        <textbox value="@bind(vm.isin)" width="200px"/>
                    </row>
                    <row>
                        <label value="Ad:"/>
                        <textbox value="@bind(vm.ad)" width="300px"/>
                        <label value="Tip:"/>
                        <combobox value="@bind(vm.tip)" width="150px">
                            <comboitem label="HISSE"/>
                            <comboitem label="VIOP"/>
                            <comboitem label="SGMK"/>
                            <comboitem label="EUROBOND"/>
                        </combobox>
                    </row>
                    <row>
                        <label value="Borsa:"/>
                        <textbox value="@bind(vm.borsa)" width="150px"/>
                        <label value="Aktif:"/>
                        <checkbox checked="@bind(vm.aktif)"/>
                    </row>
                </rows>
            </grid>
            <hbox spacing="10px" style="margin-top:10px">
                <button label="Kaydet" style="background:#4caf50 !important;color:white !important;text-shadow:none !important"
                        onClick="@command('kaydet')"/>
                <button label="Yeni Enstruman" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                        onClick="@command('yeniEnstruman')"/>
            </hbox>
        </groupbox>

        <separator style="margin-top:14px"/>
        <hbox spacing="8px" align="center" style="margin-top:6px">
            <label value="Ara:"/>
            <textbox value="@bind(vm.aramaMetni)" width="260px"
                     placeholder="Sembol / Ad / ISIN / Tip"/>
            <button label="Ara" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                    onClick="@command('ara')"/>
        </hbox>

        <listbox model="@load(vm.enstrumanlar)" mold="paging" pageSize="20"
                 emptyMessage="No Rows To Show" style="margin-top:10px">
            <listhead>
                <listheader label="Sembol" width="110px"/>
                <listheader label="Ad"/>
                <listheader label="ISIN" width="150px"/>
                <listheader label="Tip" width="100px"/>
                <listheader label="Borsa" width="100px"/>
                <listheader label="Aktif" width="80px"/>
                <listheader label="Aksiyon" width="140px"/>
            </listhead>
            <template name="model">
                <listitem>
                    <listcell label="@load(each.sembol)"/>
                    <listcell label="@load(each.ad)"/>
                    <listcell label="@load(each.isin)"/>
                    <listcell label="@load(each.tip)"/>
                    <listcell label="@load(each.borsa)"/>
                    <listcell label="@load(each.aktif ? 'Evet' : 'Hayir')"/>
                    <listcell>
                        <hbox spacing="6px">
                            <button label="Duzenle" style="background:#e08020 !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('duzenle', item=each)"/>
                            <button label="Sil" style="background:#c85c5c !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('sil', item=each)"/>
                        </hbox>
                    </listcell>
                </listitem>
            </template>
        </listbox>
    </window>
</zk>
