<?page title="Hesap Bazinda VIOP Risk Profili Tanim"?>
<zk>
    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.orion.core.vm.ViopRiskProfiliViewModel')"
            style="padding:16px">

        <label value="Hesap Bazinda VIOP Risk Profili Tanim"
               style="color:#2f6fad;font-size:20px;font-weight:bold"/>
        <separator/>

        <groupbox closable="false" style="margin-top:10px">
            <caption label="Profil Ekle / Duzenle"/>
            <grid>
                <columns>
                    <column width="140px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <label value="Hesap No:"/>
                        <textbox value="@bind(vm.hesapNo)" width="200px"/>
                    </row>
                    <row>
                        <label value="Profil Adi:"/>
                        <textbox value="@bind(vm.profilAdi)" width="300px"/>
                    </row>
                    <row>
                        <label value="Carpan:"/>
                        <decimalbox value="@bind(vm.carpan)" cols="8"/>
                    </row>
                </rows>
            </grid>
            <hbox spacing="10px" style="margin-top:10px">
                <button label="Kaydet" style="background:#4caf50 !important;color:white !important;text-shadow:none !important"
                        onClick="@command('kaydet')"/>
                <button label="Yeni Profil" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                        onClick="@command('yeniProfil')"/>
            </hbox>
        </groupbox>

        <separator style="margin-top:14px"/>
        <hbox spacing="8px" align="center" style="margin-top:6px">
            <label value="Ara:"/>
            <textbox value="@bind(vm.aramaMetni)" width="260px"
                     placeholder="Hesap No / Musteri / Profil Adi"/>
            <button label="Ara" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                    onClick="@command('ara')"/>
        </hbox>

        <listbox model="@load(vm.profiller)" mold="paging" pageSize="15"
                 emptyMessage="No Rows To Show" style="margin-top:10px">
            <listhead>
                <listheader label="Hesap No" width="100px"/>
                <listheader label="Musteri"/>
                <listheader label="Profil Adi" width="220px"/>
                <listheader label="Carpan" width="100px"/>
                <listheader label="Aksiyon" width="140px"/>
            </listhead>
            <template name="model">
                <listitem>
                    <listcell label="@load(each.account.hesapNo)"/>
                    <listcell label="@load(each.account.customer.adSoyadUnvan)"/>
                    <listcell label="@load(each.profilAdi)"/>
                    <listcell label="@load(each.carpan)"/>
                    <listcell>
                        <hbox spacing="6px">
                            <button label="Duzenle" style="background:#e08020 !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('duzenle', item=each)"/>
                            <button label="Sil" style="background:#c85c5c !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('sil', item=each)"/>
                        </hbox>
                    </listcell>
                </listitem>
            </template>
        </listbox>
    </window>
</zk>
