                            <button label="+" onClick="@command('raporEkle')"
                                    style="background:#2f6fad !important;color:white !important;text-shadow:none !important"/>
                        </hbox>
                        <listbox model="@load(vm.raporlar)" emptyMessage="No Rows To Show" height="140px">
