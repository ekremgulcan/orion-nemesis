                    <tabpanel>
                        <hbox spacing="6px" style="margin:6px 0">
                            <textbox value="@bind(vm.yeniGizliHesapNo)" width="160px" placeholder="Gizli Hesap No"/>
                            <button label="+" onClick="@command('gizliHesapEkle')"
                                    style="background:#2f6fad !important;color:white !important;text-shadow:none !important"/>
                        </hbox>
                        <listbox model="@load(vm.gizliHesaplar)" emptyMessage="No Rows To Show" height="140px">
                            <listhead><listheader label="Gizli Hesap No"/><listheader label="Aciklama"/></listhead>
                            <template name="model">
                                <listitem>
                                    <listcell label="@load(each.gizliHesapNo)"/><listcell label="@load(each.aciklama)"/>
                                </listitem>
                            </template>
                        </listbox>
                    </tabpanel>
                    <tabpanel>
                        <hbox spacing="6px" style="margin:6px 0">
                            <textbox value="@bind(vm.yeniTurevIslem)" width="180px" placeholder="Islem"/>
                            <button label="+" onClick="@command('turevEkle')"
                                    style="background:#2f6fad !important;color:white !important;text-shadow:none !important"/>
                        </hbox>
                        <listbox model="@load(vm.turevKomisyonlari)" emptyMessage="No Rows To Show" height="140px">
                            <listhead>
                                <listheader label="Islem"/><listheader label="Komisyon Degeri"/><listheader label="Para Birimi"/>
                            </listhead>
                            <template name="model">
                                <listitem>
                                    <listcell label="@load(each.islem)"/>
                                    <listcell label="@load(each.komisyonDegeri)"/>
                                    <listcell label="@load(each.paraBirimi)"/>
                                </listitem>
                            </template>
                        </listbox>
                    </tabpanel>
                </tabpanels>
            </tabbox>
            <div style="text-align:right;margin-top:8px">
                <button label="Tamam" style="background:#4caf50 !important;color:white !important;text-shadow:none !important"
                        onClick="@command('hesapKaydet')"/>
            </div>
        </window>
    </window>
</zk>
