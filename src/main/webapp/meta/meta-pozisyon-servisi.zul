<?page title="Meta Pozisyon Servisi"?>
<zk>
    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.orion.meta.vm.MetaPozisyonServisiViewModel')"
            style="padding:16px">

        <label value="Meta Pozisyon Servisi"
               style="color:#2f6fad;font-size:20px;font-weight:bold"/>
        <separator/>

        <label value="Pozisyon Kayitlari" style="font-weight:bold"/>
        <label value="Pozisyonlar islemlerden turetilir, salt-okunurdur." style="color:#888;font-size:12px"/>
        <hbox spacing="8px" align="center" style="margin-top:6px">
            <label value="Ara:"/>
            <textbox value="@bind(vm.pozisyonAramaMetni)" width="260px"
                     placeholder="Hesap No / Musteri / Enstruman"/>
            <button label="Ara" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                    onClick="@command('pozisyonAra')"/>
        </hbox>
        <listbox model="@load(vm.pozisyonlar)" mold="paging" pageSize="15"
                 emptyMessage="No Rows To Show" style="margin-top:6px">
            <listhead>
                <listheader label="Hesap No" width="100px"/>
                <listheader label="Musteri"/>
                <listheader label="Enstruman" width="100px"/>
                <listheader label="Miktar" width="120px"/>
                <listheader label="Referans Fiyat" width="130px"/>
            </listhead>
            <template name="model">
                <listitem>
                    <listcell label="@load(each.account.hesapNo)"/>
                    <listcell label="@load(each.account.customer.adSoyadUnvan)"/>
                    <listcell label="@load(each.instrument.sembol)"/>
                    <listcell label="@load(each.miktar)"/>
                    <listcell label="@load(each.referansFiyat)"/>
                </listitem>
            </template>
        </listbox>

        <separator style="margin-top:14px"/>
        <label value="Sok Senaryolari" style="font-weight:bold"/>

        <groupbox closable="false" style="margin-top:6px">
            <caption label="Senaryo Ekle / Duzenle"/>
            <grid>
                <columns>
                    <column width="140px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <label value="Senaryo Adi:"/>
                        <textbox value="@bind(vm.senaryoAdi)" width="260px"/>
                    </row>
                    <row>
                        <label value="Currency Pair:"/>
                        <textbox value="@bind(vm.currencyPair)" width="150px"/>
                    </row>
                    <row>
                        <label value="Sok Yuzdesi:"/>
                        <decimalbox value="@bind(vm.sokYuzdesi)" cols="8"/>
                    </row>
                    <row>
                        <label value="Aktif:"/>
                        <checkbox checked="@bind(vm.aktif)"/>
                    </row>
                </rows>
            </grid>
            <hbox spacing="10px" style="margin-top:10px">
                <button label="Kaydet" style="background:#4caf50 !important;color:white !important;text-shadow:none !important"
                        onClick="@command('kaydetSenaryo')"/>
                <button label="Yeni Senaryo" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                        onClick="@command('yeniSenaryo')"/>
            </hbox>
        </groupbox>

        <hbox spacing="8px" align="center" style="margin-top:10px">
            <label value="Ara:"/>
            <textbox value="@bind(vm.senaryoAramaMetni)" width="260px"
                     placeholder="Senaryo Adi / Currency Pair"/>
            <button label="Ara" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                    onClick="@command('senaryoAra')"/>
        </hbox>

        <listbox model="@load(vm.sokSenaryolari)" mold="paging" pageSize="10"
                 emptyMessage="No Rows To Show" style="margin-top:6px">
            <listhead>
                <listheader label="Senaryo Adi" width="200px"/>
                <listheader label="Currency Pair" width="140px"/>
                <listheader label="Sok Yuzdesi" width="120px"/>
                <listheader label="Aktif" width="80px"/>
                <listheader label="Aksiyon" width="140px"/>
            </listhead>
            <template name="model">
                <listitem>
                    <listcell label="@load(each.senaryoAdi)"/>
                    <listcell label="@load(each.currencyPair)"/>
                    <listcell label="@load(each.sokYuzdesi)"/>
                    <listcell label="@load(each.aktif ? 'Evet' : 'Hayir')"/>
                    <listcell>
                        <hbox spacing="6px">
                            <button label="Duzenle" style="background:#e08020 !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('duzenleSenaryo', item=each)"/>
                            <button label="Sil" style="background:#c85c5c !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('silSenaryo', item=each)"/>
                        </hbox>
                    </listcell>
                </listitem>
            </template>
        </listbox>
    </window>
</zk>
