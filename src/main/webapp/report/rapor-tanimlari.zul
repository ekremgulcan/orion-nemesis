<?page title="Rapor Tanimlari"?>
<zk>
    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.orion.report.vm.RaporTanimlariViewModel')"
            style="padding:16px">

        <label value="Rapor Tanimlari"
               style="color:#2f6fad;font-size:20px;font-weight:bold"/>
        <separator/>

        <groupbox closable="false" style="margin-top:10px">
            <caption label="Rapor Ekle / Duzenle"/>
            <grid>
                <columns>
                    <column width="140px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <label value="Rapor Adi:"/>
                        <textbox value="@bind(vm.raporAdi)" width="300px"/>
                    </row>
                    <row>
                        <label value="Rapor Sinifi:"/>
                        <textbox value="@bind(vm.raporSinifi)" width="350px"/>
                    </row>
                    <row>
                        <label value="Zamanlama:"/>
                        <combobox value="@bind(vm.zamanlama)" width="150px">
                            <comboitem label="MANUEL"/>
                            <comboitem label="GUNLUK"/>
                            <comboitem label="HAFTALIK"/>
                            <comboitem label="AYLIK"/>
                        </combobox>
                    </row>
                    <row>
                        <label value="Mail Gonder:"/>
                        <checkbox checked="@bind(vm.mailGonder)"/>
                    </row>
                    <row>
                        <label value="Icerik:"/>
                        <textbox value="@bind(vm.icerik)" multiline="true" rows="6" width="450px"/>
                    </row>
                </rows>
            </grid>
            <hbox spacing="10px" style="margin-top:10px">
                <button label="Kaydet" style="background:#4caf50 !important;color:white !important;text-shadow:none !important"
                        onClick="@command('kaydet')"/>
                <button label="Yeni Rapor" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                        onClick="@command('yeniRapor')"/>
            </hbox>
        </groupbox>

        <separator style="margin-top:14px"/>
        <hbox spacing="8px" align="center" style="margin-top:6px">
            <label value="Ara:"/>
            <textbox value="@bind(vm.aramaMetni)" width="260px"
                     placeholder="Rapor Adi / Rapor Sinifi"/>
            <button label="Ara" style="background:#2f6fad !important;color:white !important;text-shadow:none !important"
                    onClick="@command('ara')"/>
        </hbox>
        <label value="Rapor Listesi" style="font-weight:bold;margin-top:6px"/>
        <listbox model="@load(vm.raporlar)" mold="paging" pageSize="15"
                 emptyMessage="No Rows To Show" style="margin-top:6px">
            <listhead>
                <listheader label="Rapor Adi" width="220px"/>
                <listheader label="Rapor Sinifi" width="260px"/>
                <listheader label="Zamanlama" width="110px"/>
                <listheader label="Mail Gonder" width="100px"/>
                <listheader label="Aksiyon" width="140px"/>
            </listhead>
            <template name="model">
                <listitem>
                    <listcell label="@load(each.raporAdi)"/>
                    <listcell label="@load(each.raporSinifi)"/>
                    <listcell label="@load(each.zamanlama)"/>
                    <listcell label="@load(each.mailGonder)"/>
                    <listcell>
                        <hbox spacing="6px">
                            <button label="Duzenle" style="background:#e08020 !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('duzenle', item=each)"/>
                            <button label="Sil" style="background:#c85c5c !important;color:white !important;text-shadow:none !important"
                                    onClick="@command('sil', item=each)"/>
                        </hbox>
                    </listcell>
                </listitem>
            </template>
        </listbox>
    </window>
</zk>
